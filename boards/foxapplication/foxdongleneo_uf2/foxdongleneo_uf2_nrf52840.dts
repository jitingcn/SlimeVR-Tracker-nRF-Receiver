/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,
				<NRF_PSEL(PWM_OUT1, 0, 17)>,
				<NRF_PSEL(PWM_OUT2, 0, 15)>;
			nordic,drive-mode = <NRF_DRIVE_D0S1>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,
				<NRF_PSEL(PWM_OUT1, 0, 17)>,
				<NRF_PSEL(PWM_OUT2, 0, 15)>;
			low-power-enable;
		};
	};
};

/ {
	model = "FoxApplication nRF52840 FoxDongleNEO";
	compatible = "foxapplication,foxdongleneo";

	chosen {
		zephyr,console = &cdc_acm_uart;
		zephyr,shell-uart = &cdc_acm_uart;
		zephyr,uart-mcumgr = &cdc_acm_uart;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	nrf_radio_fem: radio-fem {
		compatible = "skyworks,sky66112-11", "radio-fem-two-ctrl-pins";
		ctx-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		ctx-settle-time-us = <23>;
		crx-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		crx-settle-time-us = <8>;
		tx-gain-db = <22>;
		rx-gain-db = <12>;
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led0: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
		pwm_led1: pwm_led_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
		pwm_led2: pwm_led_2 {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "Red (P0.13)";
		};
		led1: led_1 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "Green (P0.17)";
		};
		led2: led_2 {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "Blue (P0.15)";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio1 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Pairing button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		sw0 = &button0;
		pwm-led0 = &pwm_led0;
		pwm-led1 = &pwm_led1;
		pwm-led2 = &pwm_led2;
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		watchdog0 = &wdt0;
	};
};

&reg0 {
	status = "disabled";
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&radio {
	fem = <&nrf_radio_fem>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&uicr {
	nfct-pins-as-gpios;
	gpio-as-nreset;
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart: cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&cryptocell {
	status = "disabled";
};

&nfct {
	status = "disabled";
};
