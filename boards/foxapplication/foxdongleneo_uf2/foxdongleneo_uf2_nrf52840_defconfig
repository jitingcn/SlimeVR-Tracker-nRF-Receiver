CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_PWM=y
CONFIG_LED_RGB_COLOR=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="FoxApplication"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="FoxApplication Receiver FoxDongleNEO"

CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_LOG_BACKEND_RTT=y

CONFIG_MPSL=y
CONFIG_MPSL_FEM=y
CONFIG_MPSL_FEM_SIMPLE_GPIO=y
CONFIG_RADIO_TX_POWER=30

# Generate an image for the Adafruit nRF52 UF2 bootloader.
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0xada52840"
